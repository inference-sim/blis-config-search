# The pinned BLIS stack: the ONE source of truth for "which simulator produced these reports".
#
# Read by scripts/build_catalog.py (the `inference-sim` version pill in the site footer) and by
# .github/workflows/generate-report.yml (which clones exactly these refs before running a search).
# SETUP.md documents the same pins for a human setting the skill up by hand.
#
# Shell-sourceable (`set -a; . pins.env; set +a`) and parsed as plain KEY=VALUE lines by Python,
# so keep it to unquoted, comment-or-assignment lines.
#
# Bumping a pin: change it here, then re-run `python3 -I scripts/test_build.py` (it checks this
# file against SETUP.md and the workflow) and rebuild the site.

# inference-sim release whose binary prices every run. BLIS_SHA is the commit the tag pointed at
# when it was pinned; the tag is NOT immutable upstream, so SETUP.md verifies the SHA on clone.
BLIS_REF=v0.12.0
BLIS_SHA=f199223d701d96dddeb1c314509bed003515b599

# blis-latency-kernel, pinned in inference-sim's own go.mod at BLIS_REF (recorded, not cloned).
KERNEL_REF=v0.3.0

# The catalog + registry the pinned binary runs against. The registry MUST be v0.2.0 or later:
# it carries the cost-model-memory coefficient set the kernel backend needs AND the acceptance/
# profiles that price speculative decoding (v0.1.1 has cost-model-memory but no acceptance/).
CATALOG_REF=0.3.0
REGISTRY_REF=v0.2.0
