{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blis-config-search/experiment.schema.json",
  "title": "config-search experiment spec",
  "description": "One scenario, several sweeps. Every run uses exactly scenario.gpus GPUs. engine: keys are blis-vllm's engine block (rules/engineconfig.Engine, modelling vLLM v0.32.0); parallel: keys are the blis-schemas pool layout blis-vllm reads; router: is the Deployment's llm-d block. Load (concurrency) is set once in the scenario. See knobs.md.",
  "type": "object",
  "required": [
    "name",
    "scenario",
    "sweeps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "#/$defs/id"
    },
    "scenario": {
      "type": "object",
      "required": [
        "model",
        "hardware",
        "workload",
        "gpus",
        "concurrency"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "workload": {
          "type": "string"
        },
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_p99": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s)$"
            },
            "itl_p99": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s)$"
            },
            "e2e_p99": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s)$"
            }
          }
        },
        "concurrency": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "blis run --concurrency levels every config runs at: closed-loop users for a shape workload, session lanes for a replay."
        },
        "gpus": {
          "type": "integer",
          "minimum": 1,
          "description": "EVERY run uses exactly this many GPUs: tp x dp x num-instances (or the prefill + decode pools' sum) must equal it. Combos that don't are dropped."
        }
      }
    },
    "sweeps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/aggregated"
          },
          {
            "$ref": "#/$defs/disaggregated"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tp": {
          "$ref": "#/$defs/values",
          "description": "blis-schemas parallel.tp -> vLLM parallel_config.tensor_parallel_size"
        },
        "dp": {
          "$ref": "#/$defs/values",
          "description": "blis-schemas parallel.dp -> vLLM parallel_config.data_parallel_size"
        },
        "enable_expert_parallel": {
          "$ref": "#/$defs/values",
          "description": "blis-schemas parallel.enable_expert_parallel -> vLLM parallel_config.enable_expert_parallel"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_num_seqs": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.max_num_seqs -> vLLM v0.32.0 scheduler_config.max_num_seqs"
        },
        "max_num_batched_tokens": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.max_num_batched_tokens -> vLLM v0.32.0 scheduler_config.max_num_batched_tokens"
        },
        "long_prefill_token_threshold": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.long_prefill_token_threshold -> vLLM v0.32.0 scheduler_config.long_prefill_token_threshold"
        },
        "max_num_active_seqs": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.max_num_active_seqs -> vLLM v0.32.0 scheduler_config.max_num_active_seqs"
        },
        "watermark": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.watermark -> vLLM v0.32.0 scheduler_config.watermark"
        },
        "scheduling_policy": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.scheduling_policy -> vLLM v0.32.0 scheduler_config.policy"
        },
        "block_size": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.block_size -> vLLM v0.32.0 cache_config.block_size"
        },
        "enable_prefix_caching": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.enable_prefix_caching -> vLLM v0.32.0 cache_config.enable_prefix_caching"
        },
        "max_model_len": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.max_model_len -> vLLM v0.32.0 model_config.max_model_len"
        },
        "gpu_memory_utilization": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.gpu_memory_utilization -> vLLM v0.32.0 cache_config.gpu_memory_utilization"
        },
        "cache_dtype": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.cache_dtype -> vLLM v0.32.0 cache_config.cache_dtype"
        },
        "quantization": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.quantization -> vLLM v0.32.0 model_config.quantization"
        },
        "all2all_backend": {
          "$ref": "#/$defs/values",
          "description": "blis-vllm engine.all2all_backend -> vLLM v0.32.0 parallel_config.all2all_backend"
        },
        "speculative": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "num_spec_tokens"
          ],
          "description": "blis-vllm engine.speculative -> vLLM v0.32.0 speculative_config",
          "properties": {
            "method": {
              "$ref": "#/$defs/values",
              "description": "speculative_config.method"
            },
            "num_spec_tokens": {
              "$ref": "#/$defs/values",
              "description": "speculative_config.num_speculative_tokens"
            }
          }
        }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel": {
          "$ref": "#/$defs/parallel"
        },
        "engine": {
          "$ref": "#/$defs/engine"
        }
      }
    },
    "aggregated": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "num-instances": {
          "$ref": "#/$defs/values"
        },
        "parallel": {
          "$ref": "#/$defs/parallel"
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "router": {
          "$ref": "#/$defs/router"
        }
      }
    },
    "disaggregated": {
      "type": "object",
      "required": [
        "name",
        "prefill",
        "decode"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "prefill-instances": {
          "$ref": "#/$defs/values"
        },
        "decode-instances": {
          "$ref": "#/$defs/values"
        },
        "prefill": {
          "$ref": "#/$defs/pool"
        },
        "decode": {
          "$ref": "#/$defs/pool"
        },
        "router": {
          "$ref": "#/$defs/router"
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "description": "The Deployment's router: block (blis-schemas v0.5.0 Router), read by the embedded llm-d router.",
      "properties": {
        "endpoint_picker_config": {
          "$ref": "#/$defs/values",
          "description": "EndpointPickerConfig file(s): scorers, weights, pickers, P/D deciders, admission, flow control."
        },
        "epp_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Alternatives, each a verbatim list of EPP command-line flags."
        },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Alternatives, each a list of InferencePool / InferenceObjective manifest files."
        },
        "plugins": {
          "type": "object",
          "minProperties": 1,
          "description": "Override fields of plugins in the base EndpointPickerConfig, keyed by plugin name (defaults to its type). Leaves are value lists.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameters": {
                "$ref": "#/$defs/epp_override"
              }
            }
          }
        },
        "schedulingProfiles": {
          "type": "object",
          "minProperties": 1,
          "description": "Override per-profile plugin entries, keyed by profile name then pluginRef. Only `weight` is a profile-level field.",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weight": {
                  "$ref": "#/$defs/values"
                }
              }
            }
          }
        }
      },
      "dependentRequired": {
        "plugins": [
          "endpoint_picker_config"
        ],
        "schedulingProfiles": [
          "endpoint_picker_config"
        ]
      }
    },
    "epp_override": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/values"
          },
          {
            "$ref": "#/$defs/epp_override"
          }
        ]
      }
    }
  }
}
