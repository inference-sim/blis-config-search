,null,null,null,null,null,4,61.95,1982.3,120.2,8.32,7260.6,1]],"run_id":"deepseek-v4-1-flash-b200-agentx-4node","setup":{"hours":3.9,"runs":183,"script":"# the stack that priced this report (needs git and Go)\ngit clone --branch v0.15.0 --depth 1 https://github.com/inference-sim/inference-sim.git inference-sim\ntest \"$(git -C inference-sim rev-parse HEAD)\" = 762f1605ff27cd825d6b2cb2d9e991cd4b864c91 || echo \"inference-sim: v0.15.0 moved off 762f1605\" >&2\n(cd inference-sim && go build -o blis main.go)\nexport PATH=\"$PWD/inference-sim:$PATH\"\n\ngit clone --branch 0.5.0 --depth 1 https://github.com/inference-sim/blis-catalog.git blis-catalog\ntest \"$(git -C blis-catalog rev-parse HEAD)\" = b5550f750cb51571498577fbdc1c68f78cda67db || echo \"blis-catalog: 0.5.0 moved off b5550f75\" >&2\nexport BLIS_CATALOG=\"$PWD/blis-catalog\"\n\ngit clone --branch v0.3.0 --depth 1 https://github.com/inference-sim/blis-registry.git blis-registry\ntest \"$(git -C blis-registry rev-parse HEAD)\" = 96bead697172ab7f2cf8346e04e65b837014d867 || echo \"blis-registry: v0.3.0 moved off 96bead69\" >&2\nexport BLIS_REGISTRY=\"$PWD/blis-registry\"\n\n# the commands run from this repo: router configs live here, scenarios/ is where you save each scenario\ngit clone --depth 1 https://github.com/inference-sim/blis-config-search.git && cd blis-config-search && mkdir -p scenarios\n\n# the replay corpus (not vendored anywhere; checked against its digest)\nmkdir -p .corpus\ncurl -L -o .corpus/traces.jsonl https://huggingface.co/datasets/semianalysisai/cc-traces-weka-062126-256k/resolve/8fecd2fc56694469f758f0afbbb6335ad3043740/traces.jsonl\necho \"e39cd2ff3eba21d4a3664be51da743ac3d2149a1933898cafc7bfeac8147eeef  .corpus/traces.jsonl\" | shasum -a 256 -c\n","stack":[{"commit":"762f1605ff27cd825d6b2cb2d9e991cd4b864c91","name":"BLIS","ref":"v0.15.0","repo":"inference-sim"},{"commit":"b5550f750cb51571498577fbdc1c68f78cda67db","name":"catalog","ref":"0.5.0","repo":"blis-catalog"},{"commit":"96bead697172ab7f2cf8346e04e65b837014d867","name":"registry","ref":"v0.3.0","repo":"blis-registry"},{"commit":null,"name":"latency kernel","ref":"v0.5.0","repo":"blis-latency-kernel"}],"sweep":"# in the blis-config-search checkout, after the install script\npython3 -m venv .venv && . .venv/bin/activate && pip install pyyaml\npython3 -I scripts/run_experiment.py reports/deepseek-v4-1-flash-b200-agentx-4node/spec.yaml --dry-run --catalog \"$BLIS_CATALOG\"\npython3 -I scripts/run_experiment.py reports/deepseek-v4-1-flash-b200-agentx-4node/spec.yaml \\\n  --blis \"$(command -v blis)\" --catalog \"$BLIS_CATALOG\" --registry \"$BLIS_REGISTRY\" \\\n  --out repro/\n"},"slo":{"itl_p99":"20ms"},"spec_yaml":"name: deepseek-v4-1-flash-b200-agentx-4node\nscenario:\n  model: deepseek-v4.1-flash\n  hardware: b200\n  workload: agentx-mvp\n  gpus: 32\n  slo:\n    itl_p99: 20ms\n  engine:\n    cache_dtype: fp8_ds_mla\n    max_model_len: 262144\n  concurrency:\n  - 32\n  - 64\n  - 128\n  replay:\n    corpus: .corpus/traces.jsonl\n    corpus_cache: /tmp/agx-cache-b200\n    grace_period: inf\nsweeps:\n- name: topology-ep\n  narrative: Mid-width tp4 instances should win at the SLO, and EP should matter little\n    at dp 1 but cost throughput once dp spreads experts wider.\n  num-instances:\n  - 2\n  - 4\n  - 8\n  - 16\n  parallel:\n    tp:\n    - 2\n    - 4\n    - 8\n    dp:\n    - 1\n    - 2\n    enable_expert_parallel:\n    - true\n    - false\n- name: batch-tokens\n  narrative: The per-step token cap should bind harder on four wide instances than\n    on eight narrow ones, since long agentic prompts concentrate per instance.\n  num-instances:\n  - 4\n  - 8\n  parallel:\n    tp:\n    - 8\n    - 4\n    dp:\n    - 1\n    enable_expert_parallel:\n    - true\n  engine:\n    max_num_batched_tokens:\n    - 2048\n    - 16384\n    - 32768\n- name: prefill-chunking\n  narrative: Capping prefill chunks should cost throughput at both widths, more where\n    fewer decodes share each instance's token budget.\n  num-instances:\n  - 4\n  - 8\n  parallel:\n    tp:\n    - 8\n    - 4\n    dp:\n    - 1\n    enable_expert_parallel:\n    - true\n  engine:\n    long_prefill_token_threshold:\n    - 2048\n- name: kv-capacity\n  narrative: nvfp4 KV and a higher memory fraction both buy cache, so on a prefix-heavy\n    replay they should substitute rather than add.\n  num-instances:\n  - 2\n  - 4\n  parallel:\n    tp:\n    - 16\n    - 8\n    dp:\n    - 1\n    enable_expert_parallel:\n    - true\n  engine:\n    cache_dtype:\n    - fp8_ds_mla\n    - nvfp4_ds_mla\n    gpu_memory_utilization:\n    - 0.8\n    - 0.95\n- name: moe-collective\n  narrative: A DeepEP backend should beat the allgather default at EP 16, and the\n    gap should shrink or flip at EP 4.\n  num-instances:\n  - 8\n  - 2\n  parallel:\n    tp:\n    - 4\n    - 8\n    dp:\n    - 1\n    - 2\n    enable_expert_parallel:\n    - true\n  engine:\n    all2all_backend:\n    - deepep_high_throughput\n    - deepep_low_latency\n    - deepep_v2\n    - pplx\n- name: drafting\n  narrative: dspark should raise throughput more on narrow instances, while K=5 may\n    push wide shapes past the 20ms ITL floor.\n  num-instances:\n  - 4\n  - 8\n  parallel:\n    tp:\n    - 8\n    - 4\n    dp:\n    - 1\n    enable_expert_parallel:\n    - true\n  engine:\n    speculative:\n      method:\n      - dspark\n      num_spec_tokens:\n      - 1\n      - 3\n      - 5\n- name: routing-prefix-cache\n  narrative: Prefix-affinity with caching on should lead and random with caching off\n    trail, and the gap should widen from four instances to eight.\n  num-instances:\n  - 4\n  - 8\n  parallel:\n    tp:\n    - 8\n    - 4\n    dp:\n    - 1\n    enable_expert_parallel:\n    - true\n  engine:\n    enable_prefix_caching:\n    - true\n    - false\n  router:\n    endpoint_picker_config:\n    - random.yaml\n    - load-aware.yaml\n    - queue-kv.yaml\n    - prefix-affinity.yaml\n- name: cudagraph\n  narrative: Full capture should edge out the PIECEWISE default by a f