{
  "metrics": [
    {
      "id": "busy_share",
      "formula": "busy_share",
      "statistic": "rate",
      "population": "ran_steps",
      "window": "measured",
      "unit": "fraction",
      "unfinished": "not_applicable",
      "scopes": [
        "cluster",
        "pool",
        "instance"
      ],
      "aggregates": [
        "max",
        "min"
      ],
      "better": "higher_is_better",
      "description": "Simulated time an instance's engine spent running steps, over the measured window's length; steps are clipped to the window, and pipeline stages that overlap count once. At a pool or the cluster, the instances' busy time over the window's length times the instance count. It is not a service-level figure: a share near 1 means the engine had work for every moment, not that it served it well."
    },
    {
      "id": "cache_hit_rate",
