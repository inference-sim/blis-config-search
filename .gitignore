__pycache__/
*.pyc

# Built gallery data producer output — a pure function of reports/ + gallery/; regenerated.
/site/

# Web SPA build artifacts — all regenerated by `npm run build` (prebuild stages data).
/web/node_modules/
/web/dist/
/web/public/data/

# Reports are regenerated into their run dirs on build; the committed source of truth is the
# JSON (scenario.json / pareto.json / runs.jsonl / report.json / gallery.json), not the HTML.
reports/*/index.html

# Generated BLIS scenario YAMLs written by a sweep. A reproducible intermediate — run_experiment
# regenerates them byte-identically from the spec — so the committed report carries the results,
# not the inputs BLIS was handed.
reports/*/scenarios/

# Pinned BLIS binary + extracted source (built locally; not committed)
/.build/

# Superpowers design specs and the design/mockup record — local working notes from the
# brainstorm/plan workflow, not part of what the repo ships.
/docs/superpowers/
/design/

# Replay corpora: fetched by scripts/fetch_corpus.py and digest-checked against the catalog.
# 568 MB and deliberately not vendored (blis-catalog/workloads/agentx-mvp.yaml says so).
/.corpus/
