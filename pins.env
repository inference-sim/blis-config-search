# The pinned BLIS stack: the ONE source of truth for "which simulator priced these reports".
#
# Read by scripts/build_catalog.py, .github/workflows/{generate-report,run-experiment}.yml and
# deploy/openshift/; SETUP.md documents the same pins for a human cloning by hand.
#
# Shell-sourceable (`set -a; . pins.env; set +a`) and parsed as plain KEY=VALUE by Python, so
# keep to unquoted, comment-or-assignment lines.
#
# To bump a pin: change BLIS_REF/BLIS_SHA here, re-run `python3 -I scripts/sync_pins.py` to
# regenerate the derived block below, then `python3 -I scripts/test_build.py`. What a bump
# changed belongs in its commit message, not here.

# The release whose binary prices every run. BLIS_SHA is a COMMIT, and deliberately not a binary
# digest: the same tag builds to different bytes per toolchain, so a pinned digest would be wrong
# for every contributor but its author. The runners resolve the binary's SOURCE commit and compare
# that. Upstream tags are mutable, so CI refuses a moved tag outright while a local sweep only
# warns -- testing against an unreleased simulator is how a pin bump gets evaluated.
BLIS_REF=v0.15.0
BLIS_SHA=762f1605ff27cd825d6b2cb2d9e991cd4b864c91

# The catalog + registry the pinned binary runs against. These two are hand-pinned and always
# will be: neither is a Go module, so neither can ever appear in inference-sim's dependency graph.
# They are data directories passed to the binary as arguments, and one BLIS build runs against any
# catalog version -- a genuinely independent axis that BLIS_REF says nothing about.
#
# Both floors are hard requirements, not preferences: the muse-spark-open-* models do not exist
# before catalog 0.5.0, and every Muse scenario names cost-model-fabric, the coefficient set
# registry v0.3.0 adds.
CATALOG_REF=0.5.0
REGISTRY_REF=v0.3.0

# blis-schemas / blis-vllm / blis-latency-kernel are NOT pinned by hand: they are Go dependencies
# compiled into the simulator, so BLIS_REF already determines them. sync_pins.py derives them from
# inference-sim's go.mod into the block below. Hand-typing them is what drifted before (KERNEL_REF
# read v0.3.0 while v0.15.0's go.mod wants v0.5.0 -- a stale COST MODEL version, so it misreported
# what priced a latency number). At v0.15.0 the kernel is an INDIRECT require, pulled in via
# blis-schemas, which is why the deriver reads the whole require set.

# >>> derived from inference-sim's go.mod at BLIS_REF -- DO NOT EDIT BY HAND >>>
# Regenerate with: python3 -I scripts/sync_pins.py  (after changing BLIS_REF above)
# Guarded by test_build.py::test_derived_pins_match_gomod.
SCHEMAS_REF=v0.10.0
VLLM_REF=v0.32.0-blis.1
KERNEL_REF=v0.5.0
# <<< end derived block <<<
