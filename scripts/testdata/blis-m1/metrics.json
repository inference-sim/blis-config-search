      "statistic": "rate",
      "population": "admissions",
      "window": "measured",
      "unit": "fraction",
      "unfinished": "not_applicable",
      "scopes": [
        "cluster",
        "pool",
        "instance"
      ],
      "aggregates": [
        "max",
        "min"
      ],
      "better": "higher_is_better",
      "description": "Prompt tokens served from the prefix cache over prompt tokens looked up."
    },
    {
