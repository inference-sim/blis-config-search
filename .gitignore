__pycache__/
*.pyc

# Site data built by scripts/build_gallery.py from reports/; regenerated.
/site/

# Web SPA build artifacts, regenerated by `npm run build` (prebuild stages the data).
/web/node_modules/
/web/dist/
/web/public/data/

# `scripts/report.py <run-dir>` renders here; the committed source of truth is the JSON.
reports/*/index.html

# The BLIS scenario YAMLs a sweep generates; run_experiment.py regenerates them from the spec.
reports/*/scenarios/

# Pinned BLIS binary (built locally).
/.build/

# Replay corpora: fetched by scripts/fetch_corpus.py, digest-checked, 568 MB, never vendored.
/.corpus/

# Local design notes and mockups, not shipped.
/docs/superpowers/
/design/
